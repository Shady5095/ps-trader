rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /devices/{deviceId} {
      // مسموح بالقراءة فقط للمستخدم المسجل الدخول وللأجهزة التي تخصه
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);

      // مسموح بإضافة جهاز جديد بشرط ربطه بالمستخدم المسجل
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // مسموح بالتعديل والحذف فقط لصاحب الجهاز
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
